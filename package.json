{
  "name": "min-infograph",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "release:package": "pnpm build && node release/build.mjs",
    "release:browser-smoke": "node release/browser-smoke.mjs",
    "release:pages": "pnpm release:package && node release/copy-pages.mjs",
    "release:smoke": "node release/smoke.mjs",
    "dev": "pnpm --filter @min-infograph/ir build && pnpm --filter @min-infograph/renderer build && pnpm --filter @min-infograph/workbench dev",
    "pages": "pnpm --filter @min-infograph/workbench build:pages",
    "test": "pnpm --filter @min-infograph/workbench check:browser",
    "infograph": "node release/out/cli/src/index.js",
    "release:policy-test": "node --test release/policy.test.mjs"
  },
  "devDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "7.0.2",
    "semver": "7.7.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "playwright": "1.63.0"
  }
}
