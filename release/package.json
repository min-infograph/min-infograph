{
  "name": "@min-infograph/core",
  "description": "Render Min Infograph documents in React apps and static websites",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/min-infograph/min-infograph.git"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./styles.css": {
      "types": "./styles.d.ts",
      "default": "./styles.css"
    }
  },
  "files": [
    "*.js",
    "*.css",
    "*.d.ts",
    "ir",
    "renderer"
  ],
  "sideEffects": [
    "./styles.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "license": "MIT"
}
