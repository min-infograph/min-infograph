{
  "name": "@min-infograph/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:browser": "NO_PROXY=127.0.0.1,localhost no_proxy=127.0.0.1,localhost playwright test",
    "build:pages": "tsc -b && vite build --mode github-pages",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@min-infograph/ir": "workspace:*",
    "@min-infograph/renderer": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "mermaid": "^11.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.5"
  }
}
